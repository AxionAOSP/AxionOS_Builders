# === TELEGRAM BOT CONFIGURATION ===
# Your Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCDefghIJKLmnopQRSTuvwxYZ
# Also used as TELEGRAM_TOKEN in some scripts
TELEGRAM_TOKEN=123456789:ABCDefghIJKLmnopQRSTuvwxYZ

# The main channel/group ID for build updates (e.g., -100...)
CHANNEL_ID=-1001234567890
# Also used as TELEGRAM_CHAT_ID in some scripts
TELEGRAM_CHAT_ID=-1001234567890

# Optional: Topic ID if you are using a Forum group
TOPIC_BUILDER=1

# Your Telegram User ID (for owner-only commands)
OWNER_ID=12345678

# IDs of a sticker to use for specific bot reactions
STICKER_ID=CAACAgIAAxkBAAEJ...

# === GITHUB CONFIGURATION ===
# GitHub Personal Access Token (PAT) with repo scope
GITHUB_TOKEN=ghp_your_secret_github_token_here

# Your GitHub Repository (e.g., "Owner/RepoName")
GITHUB_REPO_NAME=AxionOS/build_server

# Optional: Separate repo for database.json (defaults to GITHUB_REPO_NAME)
DB_REPO=AxionOS/build_server

# The branch to use for CI/CD and database updates (default: "actions")
GITHUB_BRANCH=actions

# === DATABASE & REDIS ===
# Redis connection string (e.g., redis://localhost:6379/0)
REDIS_URL=redis://localhost:6379/0

# === PERMISSIONS & ACCESS ===
# Comma-separated list of authorized Telegram Chat IDs
ALLOWED_CHAT_IDS=-1001234567890,-1009876543210

# Comma-separated list of authorized Admin User IDs
ADMIN_USER_IDS=12345678,87654321

# === TESTING CONFIGURATION ===
TEST_GROUP_ID=-1001111111111
TEST_CHANNEL_ID=-1002222222222

# === BUILDER CONFIGURATION ===
# Path to the build workspace (default: ".")
WORKSPACE=/home/user/axion_build
